# ============================================================
#  meu-salchipão — .env de PRODUÇÃO (raiz do repo)
#
#  Na VM:  cp .env.example .env  e preencha.  NUNCA commite o .env.
#  Usado pelo docker-compose.prod.yaml (interpolação ${VAR}) e
#  injetado no container da API (env_file). `__` vira `:` na config .NET.
#  Sem aspas, sem espaço em volta do `=`.
# ============================================================

# --- Domínios / TLS ------------------------------------------
DOMAIN_APP=meusalchipao.online
DOMAIN_API=api.meusalchipao.online
ACME_EMAIL=voce@email.com

# --- Frontend (build-time do Vite) --------------------------
# O front chama esta URL. Fica "assada" na imagem no `npm run build`.
VITE_API_URL=https://api.meusalchipao.online

# --- Banco (MySQL) -----------------------------------------
# O container do MySQL cria banco+usuário com estes valores na 1ª subida.
# A connection string da API é montada pelo compose (Server=db).
DB_NAME=meusalchipao
DB_USER=salchipao
DB_USER_PASSWORD=troque-por-uma-senha-forte
DB_ROOT_PASSWORD=troque-por-outra-senha-forte

# --- JWT -------------------------------------------------
# Gere:  openssl rand -base64 48
Jwt__SigningKey=cole-aqui-um-segredo-longo-e-aleatorio
Jwt__Issuer=meu-salchipao
Jwt__Audience=meu-salchipao

# --- CORS -----------------------------------------------
Cors__AllowedOrigins=https://meusalchipao.online,https://www.meusalchipao.online

# --- Mercado Pago -------------------------------------
# Painel MP > Suas integrações > (app) > Credenciais.
#   APP_USR-...  -> produção (Pix real)   |   TEST-...  -> sandbox
MercadoPago__AccessToken=
# Painel MP > Notificações > Webhooks: cadastre a URL abaixo e copie o secret.
MercadoPago__WebhookSecret=
MercadoPago__NotificationBaseUrl=https://api.meusalchipao.online
